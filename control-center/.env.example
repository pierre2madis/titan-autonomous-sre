# Example values only. Do not place credentials in Git.

TITAN_KAFKA_BROKER=localhost:9092

TITAN_POSTGRES_HOST=localhost
TITAN_POSTGRES_PORT=5432
TITAN_POSTGRES_DB=titan
TITAN_POSTGRES_USER=titan_app

