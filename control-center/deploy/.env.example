# TITAN Control Center — example configuration
# Copy to .env and adjust for your environment.
# Never commit .env or secret files.

TITAN_API_BIND_HOST=0.0.0.0
TITAN_API_PORT=8080
TITAN_UI_BIND_HOST=0.0.0.0
TITAN_UI_PORT=5173

TITAN_POSTGRES_HOST=postgres
TITAN_POSTGRES_PORT=5432
TITAN_POSTGRES_DB=titan
TITAN_POSTGRES_USER=titan
TITAN_POSTGRES_PASSWORD_FILE=/run/secrets/titan_postgres_password
PGSSLMODE=prefer

TITAN_KAFKA_BROKER=
TITAN_OFFLINE_INCIDENT_FILE=
TITAN_OFFLINE_CORRELATION_INPUT_FILE=
TITAN_SPLUNK_EVIDENCE_FILE=
TITAN_SPLUNK_MAX_EVIDENCE_AGE_SECONDS=300
TITAN_OUTBOX_BACKLOG_THRESHOLD_SECONDS=300

# Internal API targets for Vite development proxy
TITAN_API_PROXY_TARGET=http://127.0.0.1:8080
TITAN_SPLUNK_PROXY_TARGET=http://127.0.0.1:8080
