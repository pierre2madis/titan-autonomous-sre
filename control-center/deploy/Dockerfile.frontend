FROM node:24-bookworm-slim AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci

COPY frontend/ ./
COPY deploy/vite.portable.config.mjs ./vite.portable.config.mjs

ARG TITAN_BUILD_API_TARGET=http://127.0.0.1:18080
ARG TITAN_BUILD_SPLUNK_TARGET=http://127.0.0.1:18081

RUN TITAN_API_PROXY_TARGET="$TITAN_BUILD_API_TARGET" \
    TITAN_SPLUNK_PROXY_TARGET="$TITAN_BUILD_SPLUNK_TARGET" \
    npm run build -- --config vite.portable.config.mjs

FROM nginx:stable-alpine

COPY --from=build /app/dist /usr/share/nginx/html

COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template

EXPOSE 8080
