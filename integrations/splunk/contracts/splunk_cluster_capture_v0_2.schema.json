{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TITAN Splunk Cluster Capture v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capture_version",
    "source",
    "cluster_manager",
    "captured_at",
    "collection_status",
    "peers"
  ],
  "properties": {
    "capture_version": {
      "const": "0.2"
    },
    "source": {
      "const": "SPLUNK_CLI"
    },
    "cluster_manager": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "collection_status": {
      "const": "SUCCESS"
    },
    "peers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "status",
          "is_searchable"
        ],
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "status": {
            "type": "string"
          },
          "is_searchable": {
            "oneOf": [
              {"type": "boolean"},
              {"type": "integer", "enum": [0, 1]},
              {"type": "string", "enum": ["0", "1"]}
            ]
          }
        }
      }
    }
  }
}
